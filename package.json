{
	"name": "@rtorcato/shared-docs",
	"version": "1.19.0",
	"description": "Shared data and helpers for the @rtorcato docs sites — the framework-neutral sibling list and nav/footer builders, plus Docusaurus components.",
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"keywords": [
		"docusaurus",
		"fumadocs",
		"docs",
		"rtorcato"
	],
	"author": "Richard Torcato",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rtorcato/shared-docs.git"
	},
	"homepage": "https://github.com/rtorcato/shared-docs#readme",
	"bugs": {
		"url": "https://github.com/rtorcato/shared-docs/issues"
	},
	"sideEffects": [
		"**/*.css"
	],
	"bin": {
		"shared-docs": "./dist/cli/index.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./components/InstallTabs": {
			"types": "./dist/components/InstallTabs.d.ts",
			"default": "./dist/components/InstallTabs.js"
		},
		"./components/CommandBlock": {
			"types": "./dist/components/CommandBlock.d.ts",
			"default": "./dist/components/CommandBlock.js"
		},
		"./components/Siblings": {
			"types": "./dist/components/Siblings.d.ts",
			"default": "./dist/components/Siblings.js"
		},
		"./components/UseWithAI": {
			"types": "./dist/components/UseWithAI.d.ts",
			"default": "./dist/components/UseWithAI.js"
		},
		"./docusaurus": {
			"types": "./dist/docusaurus/index.d.ts",
			"default": "./dist/docusaurus/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"assets"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json && node scripts/copy-css.mjs",
		"prepack": "pnpm build",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"test": "node --test",
		"check:links": "node scripts/check-family-links.mjs",
		"publint": "publint --strict",
		"attw": "attw --pack --profile esm-only",
		"size": "size-limit",
		"changeset": "changeset"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "^2.6.2",
		"@changesets/cli": "^3.0.3",
		"@rtorcato/repo-tooling": "^6.1.1",
		"@size-limit/preset-small-lib": "^14.2.0",
		"@types/node": "^26.6.5",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"publint": "^0.3.25",
		"size-limit": "^14.2.0",
		"typescript": "^7.0.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22"
	}
}
