# Build output. Was committed until every consumer installed from npm rather
# than `github:rtorcato/shared-docs` — the git dep has no build step, so it
# needed prebuilt output in the tree. `files: ["dist"]` + `prepack` cover the
# npm path, so nothing needs it in git now.
dist/

# Machine-local scratch written by the `ai-issue-loop` skill each tick — the
# statusline reads it. Rewritten every 15min, so it would otherwise sit dirty
# and get swept into an agent's commit.
.claude/ai-loop-status
