node_modules
*.tsbuildinfo

# dist/ is committed on purpose — git-dep consumers install prebuilt output.
# Overrides the user's global ~/.gitignore_global `dist/` rule.
!dist/

# …but not sourcemaps. `files: ["dist"]` doesn't publish src/, so a .js.map
# would point at paths that aren't in the tarball. tsconfig sets
# `sourceMap: false`; this keeps a stray one out if that ever flips back.
dist/**/*.map

# Machine-local scratch written by the `ai-issue-loop` skill each tick — the
# statusline reads it. Rewritten every 15min, so it would otherwise sit dirty
# and get swept into an agent's commit.
.claude/ai-loop-status
